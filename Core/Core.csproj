<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>ChatApp.TcpGateway.Core</AssemblyName>
    <RootNamespace>ChatApp.TcpGateway.Core</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <!--
      Realtime.Abstractions 是 BCL-only 共享契约层（无任何外部依赖），
      Core 引用它是为了共享 PushPlatform / PushTokenLimits 等跨仓库契约类型。
      这不违反 "Core: BCL only" 约束——Realtime.Abstractions 本身不依赖 Logging/Redis/Hosting 等。
    -->
    <ProjectReference Include="..\..\ChatApp.RealtimeServices\ChatApp.Realtime.Abstractions\ChatApp.Realtime.Abstractions.csproj" />
  </ItemGroup>
</Project>
