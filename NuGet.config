<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    P1-1：版本化 Contract Package。
    本地 feed `packages/` 存放 Shared / RealtimeServices 发布的版本化契约包，
    使独立克隆本仓库即可还原构建（无需 sibling 仓库）。
    包版本由 Directory.Packages.props 锁定，并由 packages.lock.json 提供可复现锁。
  -->
  <config>
    <add key="globalPackagesFolder" value="./.nuget/packages" />
  </config>
  <packageSources>
    <clear />
    <add key="local-contracts" value="packages" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="local-contracts">
      <package pattern="ChatApp.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
