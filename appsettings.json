{
  "TcpGateway": {
    "ListenAddress": "127.0.0.1",
    "Port": 8888,
    "ListenBacklog": 512,
    "MaxConnections": 10000,
    "ReceiveBufferSize": 4096,
    "PipePauseWriterThreshold": 163840,
    "PipeResumeWriterThreshold": 81920,
    "OutboundQueueCapacity": 256,
    "MaxOutboundQueuedBytes": 262144,
    "AuthenticationTimeout": "00:00:10",
    "IdleTimeout": "00:01:30",
    "HeartbeatScanInterval": "00:00:30",
    "SendTimeout": "00:00:05",
    "MaxPacketsPerSecond": 200,
    "MaxInboundBytesPerSecond": 524288,
    "MaxInboundPayloadBytes": 81920,
    "MaxChatAttachments": 32
  },
  "RealtimeIntegration": {
    "Url": "nats://127.0.0.1:4222",
    "ClientName": "chatapp-tcp-gateway",
    "InstanceId": "tcp-gateway-local-1",
    "IncomingMessagesSubject": "chat.incoming-messages",
    "MessageReceiptsSubject": "chat.message-receipts",
    "RealtimeEventsSubject": "chat.realtime-events",
    "MessageHistoryQueriesSubject": "chat.message-history.query",
    "ConversationListQueriesSubject": "chat.conversation-list.query",
    "ConversationMarkReadsSubject": "chat.conversation-mark-read",
    "ConversationSetPrefsSubject": "chat.conversation-prefs.set",
    "MessageRecallsSubject": "chat.message-recall",
    "SyncBootstrapQueriesSubject": "chat.sync.bootstrap",
    "DeadLettersSubject": "chat.dead-letters",
    "IncomingMessagesStream": "INCOMING_MESSAGES",
    "MessageReceiptsStream": "MESSAGE_RECEIPTS",
    "RealtimeEventsStream": "REALTIME_EVENTS",
    "DeadLettersStream": "DEAD_LETTERS",
    "GatewayConsumerPrefix": "chatapp-tcp-gateway",
    "ManageStreams": false,
    "AckWaitSeconds": 60,
    "MaxDeliver": 10,
    "MaxAckPending": 512,
    "HistoryRequestTimeoutMs": 3000,
    "BackoffSeconds": [1, 5, 30, 120, 300],
    "Auth": {
      "Username": "",
      "Password": "",
      "Token": "",
      "CredsFile": ""
    }
  },
  "Observability": {
    "ServiceName": "ChatApp.TcpGateway",
    "PrometheusEnabled": false,
    "PrometheusHost": "127.0.0.1",
    "PrometheusPort": 9464,
    "OtlpEnabled": false,
    "OtlpEndpoint": "http://127.0.0.1:4317",
    "TraceSampleRatio": 0.05
  },
  "Redis": {
    "ConnectionString": "127.0.0.1:6379,abortConnect=false",
    "StartupTimeout": "00:00:10"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information",
      "ChatApp.TcpGateway.Networking": "Information"
    },
    "Console": {
      "FormatterName": "simple",
      "FormatterOptions": {
        "SingleLine": true,
        "TimestampFormat": "yyyy-MM-dd HH:mm:ss.fff zzz "
      }
    }
  }
}
